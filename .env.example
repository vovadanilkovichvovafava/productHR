# ===========================================
# HR Candidate Analyzer - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# For Railway: Add these in the Variables section

# -------------------------------------------
# DATABASE (Required)
# -------------------------------------------
# For docker-compose local development:
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hr_analyzer

# PostgreSQL Database URL (for Railway or direct connection)
# Railway provides this automatically when you add PostgreSQL
DATABASE_URL=postgresql://user:password@host:port/database

# -------------------------------------------
# AUTHENTICATION (Required)
# -------------------------------------------
# JWT Secret Key - generate a secure random string (min 32 chars)
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Ключ шифрования сканов паспортов и документов сотрудников (Fernet).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Пусто — шифрование ключом от SECRET_KEY (смена SECRET_KEY тогда ломает файлы).
PII_ENCRYPTION_KEY=
# Прежние SECRET_KEY через запятую — чтобы читать файлы, зашифрованные ими
# (перенос базы с другого сервера). Для шифрования не используются.
PII_LEGACY_SECRETS=
# Сколько адресов справа в X-Forwarded-For дописали наши прокси (Saturn, nginx
# фронта). 0 — первый адрес (его может подделать клиент). Как выбрать — по
# строке DOC_SIGN ip_chain в логе, см. CLAUDE.md «Деплой».
TRUSTED_PROXY_HOPS=0

# -------------------------------------------
# SUPER ADMIN CREDENTIALS (Required for first login)
# -------------------------------------------
# Email and password for the super admin account
# This account is created automatically on first startup
# IMPORTANT: Use strong passwords in production!
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# -------------------------------------------
# TELEGRAM BOT (Required for message collection)
# -------------------------------------------
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# HR-бот практики и испытательного срока (api/onboarding). Без ключа — выключен.
# Ключ: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ONBOARDING_WALLET_KEY=
# Страницы для кандидатов (frontend/public). Пусто в .env = значения по умолчанию ниже.
ONBOARDING_LANDING_URL=https://staffwise.club/practice/
ONBOARDING_WALLET_GUIDE_URL=https://staffwise.club/wallet/
ONBOARDING_PLATFORM_INVITE_URL=
# материалы первого рабочего дня — ДНК компании
ONBOARDING_MATERIALS_URL=https://staffwise.club/dna/
# id HR-чата для сигналов, если личка HR недоступна
ONBOARDING_HR_FALLBACK_CHAT_ID=0
ONBOARDING_DEFAULT_TZ=Europe/Moscow
ONBOARDING_PRACTICE_DAYS=7
ONBOARDING_SEND_THANKS_ON_FAIL=false
# не писать в выходные и вне 10:00–18:00 (Loom в 20:00 — по ТЗ, остаётся)
ONBOARDING_SKIP_WEEKENDS=true
# HR-аккаунты автоспамера/AI-селлера, которым бот передаёт кандидатов: @ники или Telegram ID через запятую.
# Пусто — передача выключена. По нику аккаунт должен один раз нажать Start у бота, по ID — подключён сразу.
ONBOARDING_HANDOFF_ACCOUNTS=
# Вместо Telegram-сообщения аккаунту — JSON-вебхук в их систему (если задан адрес)
ONBOARDING_HANDOFF_WEBHOOK_URL=
ONBOARDING_HANDOFF_WEBHOOK_SECRET=
# Пометки этапов (неделя, месяцы 1–3) — их система ведёт расписание сама
ONBOARDING_HANDOFF_STAGES=false
# Время старта практики для первого сообщения (в productHR хранится только дата) и HRD
ONBOARDING_PRACTICE_START_TIME=10:00
ONBOARDING_HRD=
# Секрет приёма кошелька и ответов от HR-профиля (POST /api/onboarding/inbound). Пусто — приём выключен
ONBOARDING_INBOUND_SECRET=

# -------------------------------------------
# AI SERVICES (Required for candidate analysis)
# -------------------------------------------
# Anthropic API Key for Claude AI analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key for Whisper transcription (voice/video messages)
OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------------
# PROMETHEUS INTEGRATION (for interns data)
# -------------------------------------------
# Base URL of the Prometheus service (server-only, NOT NEXT_PUBLIC)
PROMETHEUS_BASE_URL=
# API key for server-to-server communication with Prometheus
COMMUNICATION_API_KEY=
